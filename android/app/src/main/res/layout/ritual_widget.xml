<?xml version="1.0" encoding="utf-8"?>
<!-- Homescreen-Widget „Ritual – Heute“ (Farben aus dem Ritual-Theme). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ritual_widget_background"
    android:orientation="vertical"
    android:padding="14dp">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:letterSpacing="0.2"
        android:paddingBottom="4dp"
        android:text="RITUAL · HEUTE"
        android:textColor="#C9A96E"
        android:textSize="12sp" />
    <TextView
        android:id="@+id/empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:text="Keine Challenge aktiv – tippe, um eine zu finden."
        android:textColor="#A89F91"
        android:textSize="14sp" />
    <LinearLayout
        android:id="@+id/row_0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/title_0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#EFE8DC"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/streak_0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="#A89F91"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/check_0"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/ritual_widget_check"
            android:contentDescription="Abhaken"
            android:gravity="center"
            android:textColor="#C9A96E"
            android:textSize="18sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/title_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#EFE8DC"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/streak_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="#A89F91"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/check_1"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/ritual_widget_check"
            android:contentDescription="Abhaken"
            android:gravity="center"
            android:textColor="#C9A96E"
            android:textSize="18sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/title_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#EFE8DC"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/streak_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="#A89F91"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/check_2"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/ritual_widget_check"
            android:contentDescription="Abhaken"
            android:gravity="center"
            android:textColor="#C9A96E"
            android:textSize="18sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/row_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/title_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#EFE8DC"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/streak_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="#A89F91"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/check_3"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/ritual_widget_check"
            android:contentDescription="Abhaken"
            android:gravity="center"
            android:textColor="#C9A96E"
            android:textSize="18sp" />
    </LinearLayout>
</LinearLayout>
